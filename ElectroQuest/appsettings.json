    "ConnectionUri": "amqp://guest:guest@localhost:5672"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=ElectroDB;Integrated Security=True;TrustServerCertificate=True"
  }
}
